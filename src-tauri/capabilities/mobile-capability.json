{
    "identifier": "mobile-capability",
    "platforms": [
        "android",
        "iOS"
    ],
    "webviews": [
        "main"
    ],
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "dialog:default",
        "dialog:allow-ask",
        "dialog:allow-message",
        "process:allow-restart",
        "deep-link:default",
        "core:window:allow-set-theme",
        "notification:default",
        "core:webview:allow-create-webview"
    ]
}