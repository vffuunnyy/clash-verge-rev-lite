{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.clash-verge-rev.clash-verge-rev",
  "productName": "Clash Verge",
  "bundle": {
    "android": {
      "versionCode": 100,
      "minSdkVersion": 28
    }
  },
  "app": {
    "security": {
      "capabilities": [
        "mobile-capability",
        "migrated-mobile"
      ],
      "assetProtocol": {
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/../**",
          "**"
        ],
        "enable": true
      },
      "csp": null
    }
  }
}